NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://movemate:change_me@localhost:5433/movemate
TEST_DATABASE_URL=postgresql://movemate:change_me@localhost:5433/movemate_test
POSTGRES_PASSWORD=change_me

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# AI is optional: without these, the app works and checks are added by hand.
# Get a key at https://openrouter.ai/keys and pick a vision-capable model id.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_TIMEOUT_MS=45000

# Optional: the link behind the If insurance button. Leave empty to hide the button.
IF_INSURANCE_URL=https://www.if.fi/henkiloasiakkaat/vakuutukset/kotivakuutus
